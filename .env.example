# Opcional. Sem estas variáveis o jogo funciona só no aparelho (dados guardados no navegador).
# Para usar a nuvem: copie para .env.local e preencha com os dados do projeto no Supabase
# (Project Settings → API). O .env.local não vai para o git.
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon
